APP_ENV=development
DEBUG=0
SESSION_HTTPS_ONLY=0
PLATFORM_SESSION_SECRET=change-this-dev-secret-before-production

# Supabase config. In production, keep these in the deployment environment.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

ATTENDANCE_URL=http://127.0.0.1:8503
TIMETABLE_URL=http://127.0.0.1:8000
ATS_FRONTEND_URL=http://127.0.0.1:8504
ATS_BACKEND_URL=http://127.0.0.1:8001
NOTES_TEST_URL=http://127.0.0.1:5173
NOTES_TEST_API_URL=http://127.0.0.1:8002
ALUMNI_URL=

# Optional local development launch commands. These are executed from each module folder.
ATTENDANCE_START_COMMAND=streamlit run app.py --server.address 127.0.0.1 --server.port 8503
TIMETABLE_START_COMMAND=.venv\Scripts\python.exe manage.py runserver 127.0.0.1:8000
ATS_START_COMMAND=streamlit run frontend/streamlit_app.py --server.address 127.0.0.1 --server.port 8504
NOTES_TEST_START_COMMAND=cd frontend && npm run dev -- --host 127.0.0.1 --port 5173
ALUMNI_START_COMMAND=

# Optional separate backend commands for manual use when a module has more than one server.
ATS_BACKEND_START_COMMAND=uvicorn backend.main:app --host 127.0.0.1 --port 8001 --reload
NOTES_TEST_API_START_COMMAND=cd backend && uvicorn app.main:app --host 127.0.0.1 --port 8002 --reload
